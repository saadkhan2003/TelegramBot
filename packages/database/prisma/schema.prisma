datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  FROZEN
  BLOCKED
  UNDER_REVIEW
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

enum CategoryStatus {
  ACTIVE
  HIDDEN
  DISABLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  OUT_OF_STOCK
  DISABLED
  ARCHIVED
}

enum DeliveryType {
  PRELOADED_ACCOUNT
  LICENSE_KEY
  ACTIVATION_LINK
  REDEEM_CODE
  TEXT_SECRET
  FILE_DOWNLOAD
  MANUAL_DELIVERY
  API_FULFILMENT
  SUPPLIER_FULFILMENT
  CUSTOM
}

enum DeliverySpeed {
  INSTANT
  MANUAL
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  DISABLED
  EXPIRED
  REPLACED
  RETURNED
  ERROR
}

enum WalletTxType {
  DEPOSIT
  ORDER_PURCHASE
  REFUND
  REFERRAL_COMMISSION
  PROMOTIONAL_CREDIT
  ADMIN_CREDIT
  ADMIN_DEBIT
  CHARGEBACK
  REVERSAL
}

enum TxDirection {
  CREDIT
  DEBIT
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum DepositStatus {
  AWAITING_TXID
  VERIFYING
  PENDING_CONFIRMATIONS
  CONFIRMED
  CREDITED
  FAILED
  REJECTED
  DUPLICATE
  EXPIRED
  MANUAL_REVIEW
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PROCESSING
  FULFILLED
  PARTIALLY_FULFILLED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  UNDER_REVIEW
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  VIEWED
  FAILED
}

enum RefundType {
  FULL_REFUND
  PARTIAL_REFUND
  WALLET_CREDIT
  REPLACEMENT
}

enum WarrantyStatus {
  OPEN
  UNDER_REVIEW
  NEED_CUSTOMER_INFO
  APPROVED
  REJECTED
  REPLACED
  REFUNDED
  CLOSED
}

enum TicketStatus {
  OPEN
  ASSIGNED
  WAITING_CUSTOMER
  WAITING_ADMIN
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageSenderType {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum BroadcastStatus {
  DRAFT
  QUEUED
  SENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum BroadcastDeliveryStatus {
  PENDING
  SENT
  FAILED
  BLOCKED
}

// ==========================================
// USER & WALLET
// ==========================================

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  telegramUserId       BigInt        @unique @map("telegram_user_id")
  telegramUsername     String?       @map("telegram_username")
  firstName            String?       @map("first_name")
  lastName             String?       @map("last_name")
  preferredLanguage    String        @default("en") @map("preferred_language")
  status               UserStatus    @default(ACTIVE)
  referredByUserId     String?       @map("referred_by_user_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  lastSeenAt           DateTime      @default(now()) @map("last_seen_at")

  wallet               Wallet?
  orders               Order[]
  deposits             Deposit[]
  supportTickets       SupportTicket[]
  warrantyClaims       WarrantyClaim[]
  broadcastDeliveries  BroadcastDelivery[]

  // Referrals
  referrer             User?         @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referralsMade        User[]        @relation("UserReferrals")
  referralRecord       Referral?     @relation("ReferredUser")
  referralsOriginated  Referral[]    @relation("ReferrerUser")

  @@index([telegramUserId])
  @@index([status])
  @@map("users")
}

model Wallet {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @unique @map("user_id") @db.Uuid
  currency          String              @default("USD")
  cachedBalance     Decimal             @default(0) @map("cached_balance") @db.Decimal(18, 4)
  totalDeposited    Decimal             @default(0) @map("total_deposited") @db.Decimal(18, 4)
  totalSpent        Decimal             @default(0) @map("total_spent") @db.Decimal(18, 4)
  totalRefunded     Decimal             @default(0) @map("total_refunded") @db.Decimal(18, 4)
  referralEarnings  Decimal             @default(0) @map("referral_earnings") @db.Decimal(18, 4)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      WalletTransaction[]
  deposits          Deposit[]

  @@map("wallets")
}

model WalletTransaction {
  id               String                 @id @default(uuid()) @db.Uuid
  walletId         String                 @map("wallet_id") @db.Uuid
  type             WalletTxType
  direction        TxDirection
  amount           Decimal                @db.Decimal(18, 4)
  currency         String                 @default("USD")
  referenceType    String?                @map("reference_type")
  referenceId      String?                @map("reference_id")
  balanceBefore    Decimal                @map("balance_before") @db.Decimal(18, 4)
  balanceAfter     Decimal                @map("balance_after") @db.Decimal(18, 4)
  description      String
  status           TxStatus               @default(COMPLETED)
  createdByAdminId String?                @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at")

  wallet           Wallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade)
  admin            Admin?                 @relation(fields: [createdByAdminId], references: [id])
  refunds          Refund[]
  commissions      ReferralCommission[]
  orders           Order[]

  @@index([walletId, createdAt])
  @@index([type])
  @@map("wallet_transactions")
}

// ==========================================
// ADMIN & RBAC
// ==========================================

model Admin {
  id                String              @id @default(uuid()) @db.Uuid
  email             String              @unique
  passwordHash      String              @map("password_hash")
  twoFactorSecret   String?             @map("two_factor_secret")
  twoFactorEnabled  Boolean             @default(false) @map("two_factor_enabled")
  status            AdminStatus         @default(ACTIVE)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  sessions          AdminSession[]
  adminRoles        AdminRole[]
  auditLogs         AuditLog[]
  walletTransactions WalletTransaction[]
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]
  warrantyClaims    WarrantyClaim[]
  refunds           Refund[]
  broadcasts        Broadcast[]

  @@map("admins")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  adminRoles      AdminRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model AdminRole {
  adminId String @map("admin_id") @db.Uuid
  roleId  String @map("role_id") @db.Uuid

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
  @@map("admin_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminSession {
  id         String    @id @default(uuid()) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastActive DateTime  @default(now()) @map("last_active")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

// ==========================================
// CATALOG & INVENTORY
// ==========================================

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  emoji       String?
  description String?
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0) @map("sort_order")
  parentId    String?        @map("parent_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  parent      Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]     @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
}

model Product {
  id                  String         @id @default(uuid()) @db.Uuid
  categoryId          String         @map("category_id") @db.Uuid
  sku                 String         @unique
  name                String
  slug                String         @unique
  shortDescription    String?        @map("short_description")
  fullDescription     String?        @map("full_description")
  normalPrice         Decimal        @map("normal_price") @db.Decimal(18, 4)
  salePrice           Decimal?       @map("sale_price") @db.Decimal(18, 4)
  currency            String         @default("USD")
  deliveryType        DeliveryType   @map("delivery_type")
  deliverySpeed       DeliverySpeed  @default(INSTANT) @map("delivery_speed")
  warrantyEnabled     Boolean        @default(false) @map("warranty_enabled")
  warrantyDays        Int?           @map("warranty_days")
  minQuantity         Int            @default(1) @map("min_quantity")
  maxQuantity         Int            @default(100) @map("max_quantity")
  allowCustomQuantity Boolean        @default(true) @map("allow_custom_quantity")
  trackInventory      Boolean        @default(true) @map("track_inventory")
  lowStockThreshold   Int?           @default(5) @map("low_stock_threshold")
  status              ProductStatus  @default(ACTIVE)
  featured            Boolean        @default(false)
  sortOrder           Int            @default(0) @map("sort_order")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  category            Category       @relation(fields: [categoryId], references: [id])
  inventoryItems      InventoryItem[]
  orderItems          OrderItem[]

  @@index([categoryId, status])
  @@index([status])
  @@map("products")
}

model Supplier {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  contact     String?
  telegram    String?
  email       String?
  notes       String?
  status      String          @default("ACTIVE")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  inventoryItems InventoryItem[]

  @@map("suppliers")
}

model InventoryItem {
  id                   String          @id @default(uuid()) @db.Uuid
  productId            String          @map("product_id") @db.Uuid
  supplierId           String?         @map("supplier_id") @db.Uuid
  encryptedPayload     String          @map("encrypted_payload")
  status               InventoryStatus @default(AVAILABLE)
  purchaseCost         Decimal?        @map("purchase_cost") @db.Decimal(18, 4)
  purchaseReference    String?         @map("purchase_reference")
  reservedOrderId      String?         @map("reserved_order_id") @db.Uuid
  reservedAt           DateTime?       @map("reserved_at")
  reservationExpiresAt DateTime?       @map("reservation_expires_at")
  soldOrderItemId      String?         @map("sold_order_item_id") @db.Uuid
  soldAt               DateTime?       @map("sold_at")
  expiresAt            DateTime?       @map("expires_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  product              Product         @relation(fields: [productId], references: [id])
  supplier             Supplier?       @relation(fields: [supplierId], references: [id])
  deliveries           Delivery[]

  @@index([productId, status])
  @@index([status])
  @@map("inventory_items")
}

// ==========================================
// PAYMENTS & DEPOSITS
// ==========================================

model PaymentNetwork {
  id                    String     @id @default(uuid()) @db.Uuid
  name                  String     // e.g. USDT BEP20
  chain                 String     // e.g. BSC, TRON, TON
  currency              String     // e.g. USDT
  symbol                String     // e.g. USDT
  receivingAddress      String     @map("receiving_address")
  minDeposit            Decimal    @default(1.00) @map("min_deposit") @db.Decimal(18, 4)
  confirmationsRequired Int        @default(1) @map("confirmations_required")
  isActive              Boolean    @default(true) @map("is_active")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  deposits              Deposit[]

  @@map("payment_networks")
}

model Deposit {
  id               String          @id @default(uuid()) @db.Uuid
  depositNumber    String          @unique @map("deposit_number")
  userId           String          @map("user_id") @db.Uuid
  walletId         String          @map("wallet_id") @db.Uuid
  paymentNetworkId String          @map("payment_network_id") @db.Uuid
  depositAddress   String          @map("deposit_address")
  transactionHash  String          @map("transaction_hash")
  reportedAmount   Decimal?        @map("reported_amount") @db.Decimal(18, 4)
  verifiedAmount   Decimal?        @map("verified_amount") @db.Decimal(18, 4)
  status           DepositStatus   @default(AWAITING_TXID)
  blockNumber      BigInt?         @map("block_number")
  confirmations    Int?
  verificationData Json?           @map("verification_data")
  createdAt        DateTime        @default(now()) @map("created_at")
  verifiedAt       DateTime?       @map("verified_at")
  creditedAt       DateTime?       @map("credited_at")

  user             User            @relation(fields: [userId], references: [id])
  wallet           Wallet          @relation(fields: [walletId], references: [id])
  network          PaymentNetwork  @relation(fields: [paymentNetworkId], references: [id])

  @@unique([paymentNetworkId, transactionHash])
  @@index([userId, status])
  @@index([status])
  @@map("deposits")
}

// ==========================================
// ORDERS & DELIVERIES
// ==========================================

model Order {
  id                  String             @id @default(uuid()) @db.Uuid
  orderNumber         String             @unique @map("order_number")
  userId              String             @map("user_id") @db.Uuid
  subtotal            Decimal            @db.Decimal(18, 4)
  discount            Decimal            @default(0) @db.Decimal(18, 4)
  total               Decimal            @db.Decimal(18, 4)
  currency            String             @default("USD")
  status              OrderStatus        @default(PENDING)
  walletTransactionId String?            @map("wallet_transaction_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at")
  completedAt         DateTime?          @map("completed_at")
  cancelledAt         DateTime?          @map("cancelled_at")

  user                User               @relation(fields: [userId], references: [id])
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])
  items               OrderItem[]
  refunds             Refund[]
  warrantyClaims      WarrantyClaim[]
  commissions         ReferralCommission[]
  supportTickets      SupportTicket[]

  @@index([userId, status])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                   String          @id @default(uuid()) @db.Uuid
  orderId              String          @map("order_id") @db.Uuid
  productId            String          @map("product_id") @db.Uuid
  productNameSnapshot  String          @map("product_name_snapshot")
  unitPrice            Decimal         @map("unit_price") @db.Decimal(18, 4)
  quantity             Int
  total                Decimal         @db.Decimal(18, 4)
  warrantyDaysSnapshot Int?            @map("warranty_days_snapshot")
  status               String          @default("COMPLETED")
  createdAt            DateTime        @default(now()) @map("created_at")

  order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product         @relation(fields: [productId], references: [id])
  deliveries           Delivery[]
  refunds              Refund[]
  warrantyClaims       WarrantyClaim[]

  @@map("order_items")
}

model Delivery {
  id                       String         @id @default(uuid()) @db.Uuid
  orderItemId              String         @map("order_item_id") @db.Uuid
  inventoryItemId          String?        @map("inventory_item_id") @db.Uuid
  encryptedDeliveryPayload String         @map("encrypted_delivery_payload")
  deliveryMethod           String         @default("TELEGRAM_INSTANT") @map("delivery_method")
  telegramMessageId        BigInt?        @map("telegram_message_id")
  deliveredAt              DateTime?      @map("delivered_at")
  viewedAt                 DateTime?      @map("viewed_at")
  status                   DeliveryStatus @default(PENDING)
  createdAt                DateTime       @default(now()) @map("created_at")

  orderItem                OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  inventoryItem            InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@map("deliveries")
}

model Refund {
  id                  String             @id @default(uuid()) @db.Uuid
  orderId             String             @map("order_id") @db.Uuid
  orderItemId         String?            @map("order_item_id") @db.Uuid
  walletTransactionId String?            @map("wallet_transaction_id") @db.Uuid
  type                RefundType
  amount              Decimal            @db.Decimal(18, 4)
  reason              String
  notes               String?
  createdByAdminId    String             @map("created_by_admin_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at")

  order               Order              @relation(fields: [orderId], references: [id])
  orderItem           OrderItem?         @relation(fields: [orderItemId], references: [id])
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])
  admin               Admin              @relation(fields: [createdByAdminId], references: [id])

  @@map("refunds")
}

// ==========================================
// REFERRAL SYSTEM
// ==========================================

model Referral {
  id             String               @id @default(uuid()) @db.Uuid
  referrerUserId String               @map("referrer_user_id") @db.Uuid
  referredUserId String               @unique @map("referred_user_id") @db.Uuid
  source         String?
  createdAt      DateTime             @default(now()) @map("created_at")

  referrer       User                 @relation("ReferrerUser", fields: [referrerUserId], references: [id])
  referred       User                 @relation("ReferredUser", fields: [referredUserId], references: [id])
  commissions    ReferralCommission[]

  @@index([referrerUserId])
  @@map("referrals")
}

model ReferralCommission {
  id                  String             @id @default(uuid()) @db.Uuid
  referralId          String             @map("referral_id") @db.Uuid
  orderId             String             @map("order_id") @db.Uuid
  walletTransactionId String?            @map("wallet_transaction_id") @db.Uuid
  amount              Decimal            @db.Decimal(18, 4)
  ratePercentage      Decimal            @map("rate_percentage") @db.Decimal(5, 2)
  status              String             @default("CREDITED")
  createdAt           DateTime           @default(now()) @map("created_at")
  creditedAt          DateTime?          @map("credited_at")

  referral            Referral           @relation(fields: [referralId], references: [id])
  order               Order              @relation(fields: [orderId], references: [id])
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])

  @@map("referral_commissions")
}

// ==========================================
// SUPPORT & WARRANTY
// ==========================================

model SupportTicket {
  id             String           @id @default(uuid()) @db.Uuid
  ticketNumber   String           @unique @map("ticket_number")
  userId         String           @map("user_id") @db.Uuid
  orderId        String?          @map("order_id") @db.Uuid
  category       String
  priority       TicketPriority   @default(NORMAL)
  status         TicketStatus     @default(OPEN)
  assignedAdminId String?         @map("assigned_admin_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  closedAt       DateTime?        @map("closed_at")

  user           User             @relation(fields: [userId], references: [id])
  order          Order?           @relation(fields: [orderId], references: [id])
  assignedAdmin  Admin?           @relation(fields: [assignedAdminId], references: [id])
  messages       SupportMessage[]

  @@index([userId, status])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id                String            @id @default(uuid()) @db.Uuid
  ticketId          String            @map("ticket_id") @db.Uuid
  senderType        MessageSenderType @map("sender_type")
  senderAdminId     String?           @map("sender_admin_id") @db.Uuid
  messageText       String            @map("message_text")
  telegramMessageId BigInt?           @map("telegram_message_id")
  createdAt         DateTime          @default(now()) @map("created_at")

  ticket            SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin             Admin?            @relation(fields: [senderAdminId], references: [id])

  @@map("support_messages")
}

model WarrantyClaim {
  id                     String         @id @default(uuid()) @db.Uuid
  claimNumber            String         @unique @map("claim_number")
  userId                 String         @map("user_id") @db.Uuid
  orderId                String         @map("order_id") @db.Uuid
  orderItemId            String         @map("order_item_id") @db.Uuid
  reason                 String
  customerMessage        String         @map("customer_message")
  status                 WarrantyStatus @default(OPEN)
  assignedAdminId        String?        @map("assigned_admin_id") @db.Uuid
  resolution             String?
  replacementInventoryId String?        @map("replacement_inventory_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at")
  resolvedAt             DateTime?      @map("resolved_at")

  user                   User           @relation(fields: [userId], references: [id])
  order                  Order          @relation(fields: [orderId], references: [id])
  orderItem              OrderItem      @relation(fields: [orderItemId], references: [id])
  assignedAdmin          Admin?         @relation(fields: [assignedAdminId], references: [id])

  @@index([userId, status])
  @@map("warranty_claims")
}

// ==========================================
// BROADCASTS, SETTINGS & AUDIT
// ==========================================

model Broadcast {
  id              String              @id @default(uuid()) @db.Uuid
  title           String
  messageText     String              @map("message_text")
  targetFilter    Json?               @map("target_filter")
  status          BroadcastStatus     @default(DRAFT)
  totalRecipients Int                 @default(0) @map("total_recipients")
  sentCount       Int                 @default(0) @map("sent_count")
  failedCount     Int                 @default(0) @map("failed_count")
  scheduledAt     DateTime?           @map("scheduled_at")
  completedAt     DateTime?           @map("completed_at")
  createdByAdminId String?            @map("created_by_admin_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")

  createdBy       Admin?              @relation(fields: [createdByAdminId], references: [id])
  deliveries      BroadcastDelivery[]

  @@map("broadcasts")
}

model BroadcastDelivery {
  id                String                  @id @default(uuid()) @db.Uuid
  broadcastId       String                  @map("broadcast_id") @db.Uuid
  userId            String                  @map("user_id") @db.Uuid
  telegramMessageId BigInt?                 @map("telegram_message_id")
  status            BroadcastDeliveryStatus @default(PENDING)
  errorMessage      String?                 @map("error_message")
  sentAt            DateTime?               @map("sent_at")

  broadcast         Broadcast               @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([broadcastId, status])
  @@map("broadcast_deliveries")
}

model Translation {
  id           String   @id @default(uuid()) @db.Uuid
  key          String
  languageCode String   @map("language_code")
  value        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([key, languageCode])
  @@map("translations")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  isSensitive Boolean  @default(false) @map("is_sensitive")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  adminId      String?  @map("admin_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  beforeData   Json?    @map("before_data")
  afterData    Json?    @map("after_data")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  admin        Admin?   @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}
