# ==========================================
# Telegram Digital Store - Environment Config
# ==========================================

NODE_ENV=development
PORT=4000

# Base URLs
API_BASE_URL=http://localhost:4000
ADMIN_WEB_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/telegram_store?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=YourStoreBot
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
TELEGRAM_WEBHOOK_URL=https://api.yourdomain.com/api/v1/telegram/webhook

# Security & Cryptography
# 32-byte hex key for AES-256-GCM encryption of sensitive inventory credentials
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
SESSION_SECRET=super_secret_session_key_change_in_production

# Admin Initial Credentials (Seeded on first migration)
ADMIN_DEFAULT_EMAIL=admin@store.local
ADMIN_DEFAULT_PASSWORD=AdminSecurePass123!

# Store Settings
DEFAULT_CURRENCY=USD
DEFAULT_LANGUAGE=en
REFERRAL_DEFAULT_PERCENTAGE=10.00
MINIMUM_DEPOSIT_USD=1.00

# Blockchain / Verification RPCs & APIs (Optional for manual MVP verification, required for automated verification)
BSC_RPC_URL=https://bsc-dataseed.binance.org/
TRON_GRID_API_KEY=
TON_API_KEY=
