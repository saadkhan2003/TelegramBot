# ==============================================================================
# Telegram Digital Store - Production Dokploy Environment Variables
# Copy & Paste these directly into Dokploy GUI -> Environment Variables
# ==============================================================================

NODE_ENV=production
PORT=4000

# Server & Domain Configuration (Server IP: 178.105.157.51)
# When Dokploy assigns your temporary domain (e.g. https://api-delux.sslip.io), update NEXT_PUBLIC_API_URL:
